; ==============================================================
; Cache Demonstration Program
; ==============================================================
; Purpose:
;   Demonstrates cache hits and misses with different access patterns
;
; Test Cases:
;   1. Sequential access (high locality - good cache performance)
;   2. Repeated access (cache hits)
;   3. Scattered access (cache misses due to FIFO eviction)
;
; Expected Cache Behavior:
;   - First access to an address: MISS (load into cache)
;   - Repeated access: HIT (found in cache)
;   - After 16+ unique addresses: FIFO eviction (oldest entry removed)
; ==============================================================

LOC 100

; ==============================================================
; Test 1: Sequential Access Pattern
; Load consecutive memory locations - tests spatial locality
; ==============================================================
TEST1:
    LDR 0,0,500    ; Load from addr 500 (MISS)
    LDR 0,0,501    ; Load from addr 501 (MISS)
    LDR 0,0,502    ; Load from addr 502 (MISS)
    LDR 0,0,503    ; Load from addr 503 (MISS)
    LDR 0,0,504    ; Load from addr 504 (MISS)
    
; ==============================================================
; Test 2: Repeated Access Pattern
; Access same locations again - tests temporal locality
; ==============================================================
TEST2:
    LDR 0,0,500    ; Load from addr 500 (HIT - in cache)
    LDR 0,0,501    ; Load from addr 501 (HIT - in cache)
    LDR 0,0,502    ; Load from addr 502 (HIT - in cache)
    LDR 0,0,503    ; Load from addr 503 (HIT - in cache)
    LDR 0,0,504    ; Load from addr 504 (HIT - in cache)

; ==============================================================
; Test 3: Write-Through Test
; Write to cache and verify write-through to memory
; ==============================================================
TEST3:
    LDR 0,0,600    ; Load value from 600
    STR 0,0,700    ; Store to 700 (write-through: cache + memory)
    LDR 1,0,700    ; Load from 700 (should hit in cache)
    
; ==============================================================
; Test 4: Cache Eviction (FIFO)
; Fill cache with 16+ entries to trigger FIFO replacement
; ==============================================================
TEST4:
    LDR 0,0,800    ; Entry 1
    LDR 0,0,810    ; Entry 2
    LDR 0,0,820    ; Entry 3
    LDR 0,0,830    ; Entry 4
    LDR 0,0,840    ; Entry 5
    LDR 0,0,850    ; Entry 6
    LDR 0,0,860    ; Entry 7
    LDR 0,0,870    ; Entry 8
    LDR 0,0,880    ; Entry 9
    LDR 0,0,890    ; Entry 10
    LDR 0,0,900    ; Entry 11
    LDR 0,0,910    ; Entry 12
    LDR 0,0,920    ; Entry 13
    LDR 0,0,930    ; Entry 14
    LDR 0,0,940    ; Entry 15
    LDR 0,0,950    ; Entry 16 (cache full)
    
    ; Add one more - should evict oldest (addr 800)
    LDR 0,0,960    ; Entry 17 (MISS, evicts 800)
    
    ; Try to access 800 again - should be MISS (evicted)
    LDR 0,0,800    ; MISS (was evicted)
    
    ; Access 960 again - should be HIT (just added)
    LDR 0,0,960    ; HIT (in cache)

; ==============================================================
; Test 5: Mixed Read/Write Pattern
; ==============================================================
TEST5:
    LDR 0,0,1000   ; Load (MISS)
    STR 0,0,1001   ; Store (write-through)
    LDR 1,0,1001   ; Load (HIT)
    STR 1,0,1002   ; Store
    LDR 2,0,1002   ; Load (HIT)

; ==============================================================
; Program End
; ==============================================================
    HLT

; ==============================================================
; Data Section
; ==============================================================
LOC 500
DATA 100
DATA 200
DATA 300
DATA 400
DATA 500

LOC 600
DATA 0xABCD

LOC 1000
DATA 0x1234

; ==============================================================
; Expected Cache Performance:
; 
; After running this program, check cache statistics:
; - Total Accesses: ~60+
; - Hits: ~15-20 (repeated accesses)
; - Misses: ~40-45 (first accesses + evictions)
; - Hit Rate: ~30-40%
; 
; Cache trace file will show:
; - MISS entries for first access to each address
; - HIT entries for repeated accesses
; - Eviction messages when cache is full
; ==============================================================

