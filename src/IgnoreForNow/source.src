; ===========================================================
; Program 1 – Basic Machine Assembly
; -----------------------------------------------------------
; Purpose:
;   Demonstrate basic instruction execution and memory access
;   using LDR, STR, and HLT instructions.
; ===========================================================

0010 LDR 0,0,20      ; Load value from address 20 into R0
0011 STR 0,0,21      ; Store R0 into address 21
0012 HLT             ; Halt execution

; Data section
0020 DEC 000123      ; Constant 123 (octal)