# ==============================================================
# Program 1: Closest Number Finder (FINAL)
# --------------------------------------------------------------
# Step 1. Print 20 predefined numbers
# Step 2. Read user input (GUI)
# Step 3. Find the closest number
# Step 4. Print user input + closest number
# ==============================================================

LOC 050

START:
    # -------------------------------
    # 1. PRINT ALL 20 ARRAY VALUES
    # -------------------------------
    LDX 1,ARR_BASE         # X1 ← &ARRAY
    LDR 2,0,COUNT20        # R2 ← 20
PRINT_LOOP:
    LDR 0,1,0              # R0 ← M[X1]
    OUT 0,1                # print value
    STX 1,TMPX
    LDR 3,0,TMPX
    AIR 3,1
    STR 3,0,TMPX
    LDX 1,TMPX
    SOB 2,0,PRINT_LOOP

    # -------------------------------
    # 2. ASK USER FOR INPUT
    # -------------------------------
    OUT 0,1
    IN 0,0
    STR 0,0,USERBOX        # store user input

    # -------------------------------
    # 3. FIND CLOSEST VALUE
    # -------------------------------
    LDX 1,ARR_BASE
    LDR 2,0,COUNT20
    LDR 3,0,BIGVAL
    STR 3,0,MINDIFF
    STR 0,0,CLOSEST

SEARCH_LOOP:
    LDR 1,1,0              # R1 ← current value
    STR 1,0,CURRVAL
    LDR 3,0,USERBOX        # R3 ← user
    SMR 3,0,CURRVAL        # R3 ← user - current
    JGE 3,DIFF_OK          # if ≥ 0 → skip negate
    NOT 3
    AIR 3,1
DIFF_OK:
    STR 3,0,DIFFTMP
    LDR 1,0,MINDIFF
    LDR 3,0,DIFFTMP
    SMR 3,0,MINDIFF        # R3 ← diff - mindiff
    JGE 3,NO_UPDATE
    LDR 3,0,DIFFTMP
    STR 3,0,MINDIFF
    LDR 3,0,CURRVAL
    STR 3,0,CLOSEST
NO_UPDATE:
    STX 1,TMPX
    LDR 3,0,TMPX
    AIR 3,1
    STR 3,0,TMPX
    LDX 1,TMPX
    SOB 2,0,SEARCH_LOOP

    # -------------------------------
    # 4. PRINT RESULT
    # -------------------------------
    LDR 0,0,USERBOX
    OUT 0,1
    LDR 0,0,CLOSEST
    OUT 0,1
    HLT 0

# ==============================================================
# DATA SECTION
# ==============================================================
USERBOX:   DATA 0
COUNT20:   DATA 20
BIGVAL:    DATA 65535
MINDIFF:   DATA 0
CLOSEST:   DATA 0
CURRVAL:   DATA 0
DIFFTMP:   DATA 0
TMPX:      DATA 0
ARR_BASE:  DATA 0200

# ==============================================================
# ARRAY (20 VALUES)
# ==============================================================
LOC 0200
ARRAY:
    DATA -30000
    DATA  25000
    DATA -12345
    DATA   9876
    DATA  32767
    DATA -32768
    DATA  -42
    DATA   42
    DATA  16000
    DATA -16000
    DATA  1024
    DATA -8192
    DATA   7
    DATA -700
    DATA  2048
    DATA -4096
    DATA  30001
    DATA -25001
    DATA   555
    DATA  -555
